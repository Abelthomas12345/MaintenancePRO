<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:MaintenancePRO.Views" x:Class="MaintenancePRO.Views.EquipmentDetailPage" Title="Fiche équipement">
 <ScrollView><VerticalStackLayout Padding="18,18,18,28" Spacing="13"><local:PageHeader Heading="Fiche équipement" Subtitle="Informations machine et actions rapides"/><Border><VerticalStackLayout Spacing="12"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><Border WidthRequest="54" HeightRequest="54" Padding="0" BackgroundColor="#20364A" StrokeThickness="0"><Label Text="⚙" FontSize="25" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1" Spacing="5"><Label Text="{Binding Equipment.Name}" FontSize="20" FontAttributes="Bold"/><Label Text="{Binding Equipment.Code}" TextColor="#FF8A00"/></VerticalStackLayout></Grid><BoxView HeightRequest="1" Color="#29394D"/><Label Text="INFORMATIONS" FontSize="10" TextColor="#FF8A00" FontAttributes="Bold"/><Label Text="Emplacement" TextColor="#9AAABD" FontSize="12"/><Label Text="{Binding Equipment.Location}" FontAttributes="Bold"/><Label Text="Catégorie" TextColor="#9AAABD" FontSize="12"/><Label Text="{Binding Equipment.Category}" FontAttributes="Bold"/><Label Text="État actuel" TextColor="#9AAABD" FontSize="12"/><Label Text="{Binding Equipment.Status}" TextColor="#23C6A5" FontAttributes="Bold"/></VerticalStackLayout></Border><Button Text="＋  Déclarer une panne" Command="{Binding BreakdownCommand}"/><Button Text="Voir l’historique machine  →" BackgroundColor="#17283B" TextColor="#F2F5F9" Command="{Binding HistoryCommand}"/></VerticalStackLayout></ScrollView>
</ContentPage>