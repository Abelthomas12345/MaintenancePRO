<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:MaintenancePRO.Views" x:Class="MaintenancePRO.Views.InterventionDetailPage" Title="Détail intervention">
 <ScrollView><VerticalStackLayout Padding="18,18,18,28" Spacing="13">
  <local:PageHeader Heading="Détail intervention" Subtitle="Compte rendu et pièces jointes"/>
  <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#FF8A00"/>
  <Border IsVisible="{Binding HasData}"><VerticalStackLayout Spacing="9">
   <Label Text="{Binding Header}" TextColor="#23C6A5" FontSize="10" FontAttributes="Bold"/>
   <Label Text="{Binding Intervention.Title}" FontSize="21" FontAttributes="Bold"/>
   <BoxView HeightRequest="1" Color="#29394D"/>
   <Label Text="ÉQUIPEMENT" FontSize="10" TextColor="#9AAABD"/><Label Text="{Binding Intervention.Equipment.Display}" FontAttributes="Bold"/>
   <Label Text="PANNE LIÉE" FontSize="10" TextColor="#9AAABD"/><Label Text="{Binding Intervention.BreakdownTitle}"/>
   <Label Text="TECHNICIEN" FontSize="10" TextColor="#9AAABD"/><Label Text="{Binding Intervention.TechnicianText}"/>
   <Label Text="DATES" FontSize="10" TextColor="#9AAABD"/><Label Text="{Binding Dates}"/>
   <Label Text="TRAVAUX PRÉVUS" FontSize="10" TextColor="#9AAABD"/><Label Text="{Binding Intervention.WorkDescription}"/>
   <Label Text="RÉSULTAT DES TRAVAUX" FontSize="10" TextColor="#9AAABD"/><Label Text="{Binding Resolution}"/>
   <Label Text="{Binding CostText}" Style="{StaticResource Hint}" IsVisible="{Binding ShowCost}"/>
  </VerticalStackLayout></Border>
  <Button Text="Exporter le compte rendu (PDF)" Command="{Binding ExportCommand}" IsVisible="{Binding HasData}" IsEnabled="{Binding IsNotBusy}"/>

  <Label Text="PHOTOS ET PIÈCES JOINTES" Style="{StaticResource Section}"/>
  <Label Text="Aucune photo pour cette intervention." Style="{StaticResource Hint}" IsVisible="{Binding NoPhotos}"/>
  <VerticalStackLayout BindableLayout.ItemsSource="{Binding Photos}" Spacing="10">
   <BindableLayout.ItemTemplate><DataTemplate><Border Padding="10"><VerticalStackLayout Spacing="6">
    <Image Source="{Binding Source}" Aspect="AspectFit" MaximumHeightRequest="320"/>
    <Label Text="{Binding Caption}" Style="{StaticResource Hint}"/>
   </VerticalStackLayout></Border></DataTemplate></BindableLayout.ItemTemplate>
  </VerticalStackLayout>
  <Button Text="＋ Ajouter une photo" Style="{StaticResource SecondaryButton}" Command="{Binding AddPhotoCommand}" IsVisible="{Binding CanAddPhoto}" IsEnabled="{Binding IsNotBusy}"/>
 </VerticalStackLayout></ScrollView>
</ContentPage>
