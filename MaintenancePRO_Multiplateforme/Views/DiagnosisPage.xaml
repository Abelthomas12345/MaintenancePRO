<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:MaintenancePRO.Views" x:Class="MaintenancePRO.Views.DiagnosisPage" Title="Diagnostic">
 <ScrollView><VerticalStackLayout Padding="18,18,18,28" Spacing="13"><local:PageHeader Heading="Diagnostic" Subtitle="Identifier la cause et définir les actions"/><Border><VerticalStackLayout Spacing="5"><Label Text="DOSSIER DE PANNE" FontSize="10" TextColor="#FF8A00" FontAttributes="Bold"/><Label Text="Référence de panne"/><Entry Placeholder="Ex. PAN-001" Text="{Binding BreakdownCode}" MaxLength="40"/><Label Text="Cause identifiée *"/><Editor Placeholder="Cause probable ou confirmée…" Text="{Binding Cause}" HeightRequest="95" MaxLength="500"/><Label Text="Actions recommandées"/><Editor Placeholder="Contrôles, pièces et actions à mener…" Text="{Binding Actions}" HeightRequest="115" MaxLength="1000"/></VerticalStackLayout></Border><Button Text="Valider le diagnostic  →" Command="{Binding SaveCommand}"/></VerticalStackLayout></ScrollView>
</ContentPage>