<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:MaintenancePRO.Views" x:Class="MaintenancePRO.Views.SettingsPage" Title="Paramètres">
 <ScrollView><VerticalStackLayout Padding="18,18,18,28" Spacing="13">
  <local:PageHeader Heading="Paramètres" Subtitle="Compte, connexion à l’API et sécurité"/>
  <Border><VerticalStackLayout Spacing="8">
   <Label Text="MON COMPTE" Style="{StaticResource Section}"/>
   <Label Text="{Binding UserName}" FontSize="19" FontAttributes="Bold"/>
   <Label Text="{Binding Email}" Style="{StaticResource Hint}"/>
   <Label Text="{Binding RoleLabel}" TextColor="#23C6A5"/>
   <BoxView HeightRequest="1" Color="#29394D"/>
   <Label Text="{Binding Version}" Style="{StaticResource Hint}"/>
  </VerticalStackLayout></Border>
  <Border><VerticalStackLayout Spacing="6">
   <Label Text="ADRESSE DE L’API" Style="{StaticResource Section}"/>
   <Entry Text="{Binding ApiUrl}" Keyboard="Url" Placeholder="http://192.168.1.20:5080"/>
   <Label Text="Téléphone réel : saisis l'IP du PC (ex. http://192.168.1.20:5080). Émulateur Android : http://10.0.2.2:5080. HTTP n'est accepté qu'en Debug." Style="{StaticResource Hint}" FontSize="11"/>
   <Label Text="{Binding Status}" TextColor="#FF8A00"/>
   <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#FF8A00"/>
   <Button Text="Enregistrer l'adresse" Command="{Binding SaveUrlCommand}"/>
   <Button Text="Tester la connexion" Style="{StaticResource SecondaryButton}" Command="{Binding TestCommand}"/>
   <Button Text="Adresse par défaut" Style="{StaticResource SecondaryButton}" Command="{Binding ResetUrlCommand}"/>
  </VerticalStackLayout></Border>
  <Button Text="Rappels de sécurité" Style="{StaticResource SecondaryButton}" Command="{Binding SecurityCommand}"/>
  <Button Text="Se déconnecter" Style="{StaticResource DangerButton}" Command="{Binding LogoutCommand}"/>
 </VerticalStackLayout></ScrollView>
</ContentPage>
