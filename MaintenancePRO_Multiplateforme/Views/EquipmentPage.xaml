<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:MaintenancePRO.Views" x:Class="MaintenancePRO.Views.EquipmentPage" Title="Équipements">
 <ScrollView><VerticalStackLayout Padding="18,18,18,28" Spacing="13"><local:PageHeader Heading="Équipements" Subtitle="Le parc industriel · recherche et suivi"/><SearchBar Placeholder="⌕  Nom, code ou emplacement" Text="{Binding Search}"/><Grid ColumnDefinitions="*,Auto" Margin="0,4,0,2"><Label Text="PARC MACHINES" TextColor="#9AAABD" FontSize="10" FontAttributes="Bold" VerticalOptions="Center"/><Button Grid.Column="1" Text="＋ Ajouter" Padding="12,8" Command="{Binding AddCommand}"/></Grid><CollectionView ItemsSource="{Binding FilteredItems}" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate><Border Margin="0,5"><VerticalStackLayout Spacing="8"><Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="11"><Border Grid.RowSpan="2" WidthRequest="42" HeightRequest="42" Padding="0" BackgroundColor="#20364A" StrokeThickness="0"><Label Text="⚙" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/></Border><Label Grid.Column="1" Text="{Binding Name}" FontAttributes="Bold" FontSize="15"/><Label Grid.Column="2" Text="{Binding Status}" FontSize="10" TextColor="#23C6A5" VerticalOptions="Center"/><Label Grid.Row="1" Grid.Column="1" Text="{Binding Code}" FontSize="12" TextColor="#9AAABD"/><Button Grid.Row="1" Grid.Column="2" Text="Ouvrir →" Padding="9,5" FontSize="11" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCommand}" CommandParameter="{Binding .}"/></Grid><Label Text="{Binding Location}" FontSize="11" TextColor="#9AAABD" Margin="53,0,0,0"/></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout></ScrollView>
</ContentPage>