<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:views="clr-namespace:MaintenancePRO.Views"
       x:Class="MaintenancePRO.AppShell" FlyoutBehavior="Disabled" Title="MaintenancePRO" BackgroundColor="#07111F" ForegroundColor="#F2F5F9" TitleColor="#F2F5F9" FlyoutBackgroundColor="#0B1828">

 <Shell.FlyoutHeader>
  <VerticalStackLayout Padding="18,28,18,16" Spacing="3" BackgroundColor="#07111F">
   <Label Text="{Binding DisplayName}" FontSize="17" FontAttributes="Bold" TextColor="#F2F5F9"/>
   <Label Text="{Binding RoleLabel}" FontSize="12" TextColor="#FF8A00"/>
   <Label Text="{Binding Email}" FontSize="11" TextColor="#9AAABD"/>
  </VerticalStackLayout>
 </Shell.FlyoutHeader>
 <Shell.ItemTemplate><DataTemplate><Grid Padding="18,13"><Label Text="{Binding Title}" TextColor="#F2F5F9" FontSize="15" VerticalOptions="Center"/></Grid></DataTemplate></Shell.ItemTemplate>
 <Shell.MenuItemTemplate><DataTemplate><Grid Padding="18,13"><Label Text="{Binding Text}" TextColor="#FF626D" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"/></Grid></DataTemplate></Shell.MenuItemTemplate>

 <ShellContent Title="Connexion" Route="login" ContentTemplate="{DataTemplate views:LoginPage}" FlyoutItemIsVisible="False"/>
 <FlyoutItem Title="Accueil" Route="home"><ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" Route="dashboard"/></FlyoutItem>
 <FlyoutItem Title="Équipements" Route="equipments"><ShellContent ContentTemplate="{DataTemplate views:EquipmentPage}" Route="equipment-list"/></FlyoutItem>
 <FlyoutItem Title="Déclarer une panne" Route="breakdown"><ShellContent ContentTemplate="{DataTemplate views:BreakdownPage}" Route="breakdown-form"/></FlyoutItem>
 <FlyoutItem Title="Diagnostic" Route="diagnosis" FlyoutItemIsVisible="{Binding CanSeeDiagnosis}"><ShellContent ContentTemplate="{DataTemplate views:DiagnosisPage}" Route="diagnosis-form"/></FlyoutItem>
 <FlyoutItem Title="Intervention" Route="intervention" FlyoutItemIsVisible="{Binding CanSeeIntervention}"><ShellContent ContentTemplate="{DataTemplate views:InterventionPage}" Route="intervention-form"/></FlyoutItem>
 <FlyoutItem Title="Historique" Route="history"><ShellContent ContentTemplate="{DataTemplate views:HistoryPage}" Route="machine-history"/></FlyoutItem>
 <FlyoutItem Title="Rapports" Route="reports" FlyoutItemIsVisible="{Binding CanSeeReports}"><ShellContent ContentTemplate="{DataTemplate views:ReportsPage}" Route="reports-home"/></FlyoutItem>
 <FlyoutItem Title="Techniciens et comptes" Route="technicians" FlyoutItemIsVisible="{Binding CanSeeTechnicians}"><ShellContent ContentTemplate="{DataTemplate views:TechniciansPage}" Route="technicians-home"/></FlyoutItem>
 <FlyoutItem Title="Paramètres" Route="settings"><ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" Route="settings-home"/></FlyoutItem>
 <MenuItem Text="Se déconnecter" Clicked="OnLogoutClicked"/>
</Shell>
