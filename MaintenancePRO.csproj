<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Variante Windows uniquement, basée sur les interfaces MAUI retravaillées. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>MaintenancePRO</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>MaintenancePRO</ApplicationTitle>
    <ApplicationId>cm.maintenancepro.mobile</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>
  <!-- Références MAUI alignées sur la variante Windows précédente du projet. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="Resources/AppIcon/appiconfg.svg" Color="#123B5D" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#123B5D" BaseSize="128,128" />
  </ItemGroup>
</Project>
