<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:MaintenancePRO.Views" x:Class="MaintenancePRO.Views.InterventionPage" Title="Intervention">
 <ScrollView><VerticalStackLayout Padding="18,18,18,28" Spacing="13"><local:PageHeader Heading="Intervention" Subtitle="Consigner le travail réalisé sur la machine"/><Border><VerticalStackLayout Spacing="5"><Label Text="COMPTE RENDU" FontSize="10" TextColor="#FF8A00" FontAttributes="Bold"/><Label Text="Code équipement"/><Entry Placeholder="Ex. EQ-001" Text="{Binding EquipmentCode}" MaxLength="40"/><Label Text="Durée (minutes) *"/><Entry Placeholder="Ex. 45" Keyboard="Numeric" Text="{Binding DurationMinutes}" MaxLength="6"/><Label Text="Résultat de l’intervention *"/><Editor Placeholder="Travaux réalisés, pièces utilisées, résultat…" Text="{Binding Result}" HeightRequest="135" MaxLength="1000"/><Label Text="Vérifie le résultat avant de clôturer." FontSize="11" TextColor="#9AAABD"/></VerticalStackLayout></Border><Button Text="Clôturer l’intervention  ✓" Command="{Binding CloseCommand}"/></VerticalStackLayout></ScrollView>
</ContentPage>