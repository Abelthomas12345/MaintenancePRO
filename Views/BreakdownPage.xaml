<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:MaintenancePRO.Views" x:Class="MaintenancePRO.Views.BreakdownPage" Title="Déclarer une panne">
 <ScrollView><VerticalStackLayout Padding="18,18,18,28" Spacing="13"><local:PageHeader Heading="Déclarer une panne" Subtitle="Renseigne les symptômes observés"/><Border><VerticalStackLayout Spacing="5"><Label Text="NOUVELLE DÉCLARATION" TextColor="#FF8A00" FontSize="10" FontAttributes="Bold"/><Label Text="Équipement concerné *"/><Entry Placeholder="Ex. EQ-001" Text="{Binding EquipmentCode}" MaxLength="40"/><Label Text="Niveau de sévérité *"/><Picker Title="Choisir la sévérité" SelectedItem="{Binding Severity}"><Picker.Items><x:String>Faible</x:String><x:String>Moyenne</x:String><x:String>Élevée</x:String><x:String>Critique</x:String></Picker.Items></Picker><Label Text="Description du problème *"/><Editor Placeholder="Décris les symptômes, le contexte et les risques…" Text="{Binding Description}" HeightRequest="125" MaxLength="1000"/><Label Text="Les champs marqués * sont obligatoires." FontSize="11" TextColor="#9AAABD"/></VerticalStackLayout></Border><Button Text="Envoyer la déclaration  →" Command="{Binding SaveCommand}"/><Label Text="Mode prototype · données conservées localement" FontSize="11" TextColor="#71849A" HorizontalTextAlignment="Center"/></VerticalStackLayout></ScrollView>
</ContentPage>