<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:MaintenancePRO.Views" x:Class="MaintenancePRO.Views.DashboardPage" Title="Accueil">
 <ScrollView><VerticalStackLayout Padding="18,18,18,28" Spacing="13"><Grid ColumnDefinitions="*,Auto" Margin="0,0,0,5"><VerticalStackLayout Spacing="3"><Label Text="Bonjour 👋" FontSize="13" TextColor="#9AAABD"/><Label Text="Vue d’ensemble" FontSize="25" FontAttributes="Bold"/></VerticalStackLayout><Border Grid.Column="1" Padding="9" BackgroundColor="#17283B" VerticalOptions="Center"><Label Text="MP" TextColor="#FF8A00" FontAttributes="Bold"/></Border></Grid><Label Text="SUIVI DE MAINTENANCE" FontSize="10" TextColor="#FF8A00" FontAttributes="Bold"/><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10"><Border Grid.Row="0" Grid.Column="0"><VerticalStackLayout Spacing="7"><Label Text="ÉQUIPEMENTS" FontSize="10" TextColor="#9AAABD"/><Label Text="{Binding EquipmentCount}" FontSize="31" FontAttributes="Bold"/><Label Text="Parc suivi" FontSize="11" TextColor="#23C6A5"/></VerticalStackLayout></Border><Border Grid.Row="0" Grid.Column="1"><VerticalStackLayout Spacing="7"><Label Text="DOSSIERS ACTIFS" FontSize="10" TextColor="#9AAABD"/><Label Text="{Binding OpenCount}" FontSize="31" FontAttributes="Bold" TextColor="#FF8A00"/><Label Text="À traiter" FontSize="11" TextColor="#9AAABD"/></VerticalStackLayout></Border><Button Grid.Row="1" Grid.ColumnSpan="2" Text="＋  Déclarer une panne" Command="{Binding NewBreakdown}"/><Button Grid.Row="2" Grid.ColumnSpan="2" Text="Voir les équipements  →" Command="{Binding OpenEquipment}" BackgroundColor="#17283B" TextColor="#F2F5F9"/></Grid><Grid ColumnDefinitions="*,Auto" Margin="0,12,0,4"><Label Text="Dernières interventions" FontSize="17" FontAttributes="Bold"/><Label Grid.Column="1" Text="Tout voir" TextColor="#FF8A00" FontSize="12" VerticalOptions="Center"/></Grid><CollectionView ItemsSource="{Binding Data.Records}" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate><Border Margin="0,4"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><Border WidthRequest="38" HeightRequest="38" Padding="0" BackgroundColor="#20364A" StrokeThickness="0" VerticalOptions="Start"><Label Text="⚙" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="{Binding Title}" FontAttributes="Bold"/><Label Text="{Binding Equipment}" FontSize="12" TextColor="#9AAABD"/><Label Text="{Binding Status}" FontSize="11" TextColor="#23C6A5"/></VerticalStackLayout></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout></ScrollView>
</ContentPage>