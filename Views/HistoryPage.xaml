<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:MaintenancePRO.Views" x:Class="MaintenancePRO.Views.HistoryPage" Title="Historique par machine">
 <ScrollView><VerticalStackLayout Padding="18,18,18,28" Spacing="13"><local:PageHeader Heading="Historique" Subtitle="Les interventions enregistrées par machine"/><Border Padding="12"><VerticalStackLayout Spacing="7"><Label Text="FILTRER LES DOSSIERS" TextColor="#FF8A00" FontSize="10" FontAttributes="Bold"/><Picker Title="Tous les états" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}"/></VerticalStackLayout></Border><CollectionView ItemsSource="{Binding FilteredRecords}" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate><Border Margin="0,5"><VerticalStackLayout Spacing="7"><Grid ColumnDefinitions="*,Auto"><Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold"/><Label Grid.Column="1" Text="{Binding Status}" TextColor="#23C6A5" FontSize="11" VerticalOptions="Center"/></Grid><Label Text="{Binding Equipment}" TextColor="#9AAABD"/><Grid ColumnDefinitions="*,Auto"><Label Text="{Binding Date}" FontSize="11" TextColor="#9AAABD"/><Label Grid.Column="1" Text="Technicien : {Binding Technician}" FontSize="11" TextColor="#9AAABD"/></Grid></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout></ScrollView>
</ContentPage>