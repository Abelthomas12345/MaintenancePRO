using System.Net.Http.Headers;
using System.Net.Http.Json;
using System.Text.Json;
namespace MaintenancePRO.Services;
public sealed class ApiClient
{
    private readonly HttpClient _http;
    private const string TokenKey = "maintenancepro_access_token";
    public ApiClient()
    {
#if ANDROID
        // Émulateur Android : 10.0.2.2 pointe vers le PC hôte. Pour un téléphone réel,
        // remplace par l'adresse IP LAN du PC dans ApiBaseUrl.cs.
        _http = new HttpClient { BaseAddress = new Uri(ApiBaseUrl.Value) };
#else
        _http = new HttpClient { BaseAddress = new Uri(ApiBaseUrl.Value) };
#endif
        _http.Timeout = TimeSpan.FromSeconds(20);
    }
    public async Task<AuthResult> LoginAsync(string email, string password)
    {
        using var response = await _http.PostAsJsonAsync("api/auth/login", new { email, password });
        var body = await response.Content.ReadAsStringAsync();
        if (!response.IsSuccessStatusCode)
        {
            string message = "Connexion refusée. Vérifie les identifiants, le statut du compte et l'API.";
            try { using var doc = JsonDocument.Parse(body); if (doc.RootElement.TryGetProperty("message", out var m)) message = m.GetString() ?? message; } catch { }
            throw new ApiException(message, (int)response.StatusCode);
        }
        var result = JsonSerializer.Deserialize<AuthResult>(body, new JsonSerializerOptions { PropertyNameCaseInsensitive = true })
                     ?? throw new ApiException("Réponse API invalide.", 500);
        await SecureStorage.Default.SetAsync(TokenKey, result.AccessToken);
        return result;
    }
    public async Task LogoutAsync() => SecureStorage.Default.Remove(TokenKey);
    public async Task<T?> GetAsync<T>(string route)
    {
        var token = await SecureStorage.Default.GetAsync(TokenKey);
        if (string.IsNullOrWhiteSpace(token)) throw new ApiException("Session expirée. Reconnecte-toi.", 401);
        using var request = new HttpRequestMessage(HttpMethod.Get, route);
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
        using var response = await _http.SendAsync(request);
        if (!response.IsSuccessStatusCode) throw new ApiException($"Erreur API ({(int)response.StatusCode}).", (int)response.StatusCode);
        return await response.Content.ReadFromJsonAsync<T>();
    }
}
public sealed record AuthResult(string AccessToken, DateTime ExpiresUtc, string Email, string DisplayName, string[] Roles);
public sealed class ApiException(string message, int statusCode) : Exception(message) { public int StatusCode { get; } = statusCode; }
