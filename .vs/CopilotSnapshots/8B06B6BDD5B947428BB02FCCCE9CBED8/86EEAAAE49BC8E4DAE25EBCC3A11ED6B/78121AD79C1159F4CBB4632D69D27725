using MaintenancePRO.Models; using MaintenancePRO.Services; using System.Collections.ObjectModel; namespace MaintenancePRO.ViewModels; public sealed class DashboardViewModel:BaseViewModel { public DashboardData Data {get;}=new(); public int EquipmentCount=>Data.EquipmentCount; public int OpenCount=>Data.OpenBreakdowns+Data.OpenInterventions; public ObservableCollection<MaintenanceRecord> Recent {get;}=new(); public DashboardViewModel(ApiClient api){_=LoadAsync(api);} async Task LoadAsync(ApiClient api){try{var data=await api.GetDashboardAsync(); Data=data; Recent.Clear(); foreach(var x in data.RecentInterventions)Recent.Add(new MaintenanceRecord{Title=x.Title,Equipment=x.Equipment?.Name??"",Date=x.CreatedUtc.ToLocalTime().ToString("g"),Status=x.Status.ToString()}); OnPropertyChanged(nameof(Data));OnPropertyChanged(nameof(EquipmentCount));OnPropertyChanged(nameof(OpenCount));}catch(Exception ex){await Shell.Current.DisplayAlert("Tableau de bord",ex.Message,"OK");}} public Command OpenEquipment=>new(async()=>await Shell.Current.GoToAsync("//equipments/equipment-list")); public Command NewBreakdown=>new(async()=>await Shell.Current.GoToAsync("//breakdown/breakdown-form")); public Command OpenHistory=>new(async()=>await Shell.Current.GoToAsync("//history/machine-history")); }
