using System.Net.Http.Headers;
using System.Net.Http.Json;
using System.Text.Json;

namespace MaintenancePRO.Services;

public sealed class ApiClient
{
    private readonly HttpClient _http;
    private const string TokenKey = "maintenancepro_access_token";
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);

    public ApiClient() => _http = new HttpClient { BaseAddress = new Uri(ApiBaseUrl.Value), Timeout = TimeSpan.FromSeconds(20) };

    public async Task<AuthResult> LoginAsync(string email, string password)
    {
        using var response = await _http.PostAsJsonAsync("api/auth/login", new { email, password });
        var result = await ReadAsync<AuthResult>(response);
        await SecureStorage.Default.SetAsync(TokenKey, result.AccessToken);
        return result;
    }

    public Task LogoutAsync() { SecureStorage.Default.Remove(TokenKey); return Task.CompletedTask; }

    public Task<T?> GetAsync<T>(string route) => SendAsync<T>(HttpMethod.Get, route);
    public Task<T?> PostAsync<T>(string route, object body) => SendAsync<T>(HttpMethod.Post, route, body);
    public Task<T?> PutAsync<T>(string route, object body) => SendAsync<T>(HttpMethod.Put, route, body);
    public Task<T?> PatchAsync<T>(string route, object body) => SendAsync<T>(HttpMethod.Patch, route, body);

    public async Task<EquipmentPage> GetEquipmentsAsync(string? search = null)
        => await GetAsync<EquipmentPage>($"api/equipment?pageSize=100{(string.IsNullOrWhiteSpace(search) ? "" : $"&search={Uri.EscapeDataString(search)}")}") ?? new();
    public async Task<DashboardData> GetDashboardAsync() => await GetAsync<DashboardData>("api/dashboard") ?? new();
    public async Task<ReportData> GetReportsAsync() => await GetAsync<ReportData>("api/dashboard/reports") ?? new();
    public async Task<BreakdownPage> GetBreakdownsAsync() => await GetAsync<BreakdownPage>("api/breakdowns?pageSize=100") ?? new();
    public async Task<InterventionPage> GetInterventionsAsync() => await GetAsync<InterventionPage>("api/interventions?pageSize=100") ?? new();
    public async Task<AdminUsersPage> GetTechniciansAsync() => await GetAsync<AdminUsersPage>("api/admin/users?pageSize=100") ?? new();

    public async Task<EquipmentApi?> CreateEquipmentAsync(string code, string name, string location, string category)
        => await PostAsync<EquipmentApi>("api/equipment", new { code, name, location, category });
    public async Task<BreakdownApi?> CreateBreakdownAsync(string equipmentCode, string severity, string description)
    {
        var equipment = (await GetEquipmentsAsync(equipmentCode)).Items.FirstOrDefault(x => x.Code.Equals(equipmentCode, StringComparison.OrdinalIgnoreCase));
        if (equipment is null) throw new ApiException("Équipement introuvable.", 404);
        var severityValue = severity switch { "Faible" => 0, "Élevée" => 2, "Critique" => 3, _ => 1 };
        return await PostAsync<BreakdownApi>("api/breakdowns", new { equipmentId = equipment.Id, title = "Déclaration depuis l'application", description, severity = severityValue });
    }
    public async Task<DiagnosisApi?> CreateDiagnosisAsync(string breakdownCode, string findings, string? rootCause, string? action)
    {
        var breakdown = (await GetBreakdownsAsync()).Items.FirstOrDefault(x => x.Id.ToString() == breakdownCode || x.Title.Equals(breakdownCode, StringComparison.OrdinalIgnoreCase));
        if (breakdown is null) throw new ApiException("Panne introuvable.", 404);
        return await PostAsync<DiagnosisApi>($"api/diagnoses?breakdownId={breakdown.Id}", new { findings, rootCause, recommendedAction = action });
    }
    public async Task<InterventionApi?> CompleteInterventionAsync(string equipmentCode, string resolution, decimal laborHours)
    {
        var intervention = (await GetInterventionsAsync()).Items.FirstOrDefault(x => x.Equipment?.Code.Equals(equipmentCode, StringComparison.OrdinalIgnoreCase) == true);
        if (intervention is null) throw new ApiException("Intervention introuvable.", 404);
        return await PatchAsync<InterventionApi>($"api/interventions/{intervention.Id}", new { status = 4, resolution, laborHours });
    }

    private async Task<T?> SendAsync<T>(HttpMethod method, string route, object? body = null)
    {
        var token = await SecureStorage.Default.GetAsync(TokenKey);
        if (string.IsNullOrWhiteSpace(token)) throw new ApiException("Session expirée. Reconnecte-toi.", 401);
        using var request = new HttpRequestMessage(method, route);
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
        if (body is not null) request.Content = JsonContent.Create(body);
        using var response = await _http.SendAsync(request);
        return await ReadAsync<T>(response);
    }

    private static async Task<T> ReadAsync<T>(HttpResponseMessage response)
    {
        var body = await response.Content.ReadAsStringAsync();
        if (!response.IsSuccessStatusCode)
        {
            var message = $"Erreur API ({(int)response.StatusCode}).";
            try { using var document = JsonDocument.Parse(body); if (document.RootElement.TryGetProperty("message", out var m)) message = m.GetString() ?? message; } catch { }
            throw new ApiException(message, (int)response.StatusCode);
        }
        if (string.IsNullOrWhiteSpace(body)) return default!;
        return JsonSerializer.Deserialize<T>(body, JsonOptions) ?? throw new ApiException("Réponse API invalide.", 500);
    }
}

public sealed record AuthResult(string AccessToken, DateTime ExpiresUtc, string Email, string DisplayName, string[] Roles);
public sealed class ApiException(string message, int statusCode) : Exception(message) { public int StatusCode { get; } = statusCode; }
public sealed class EquipmentPage { public List<EquipmentApi> Items { get; set; } = []; }
public sealed class BreakdownPage { public List<BreakdownApi> Items { get; set; } = []; }
public sealed class InterventionPage { public List<InterventionApi> Items { get; set; } = []; }
public sealed class AdminUsersPage { public List<UserApi> Items { get; set; } = []; }
public sealed class EquipmentApi { public int Id { get; set; } public string Code { get; set; } = ""; public string Name { get; set; } = ""; public string Location { get; set; } = ""; public string Category { get; set; } = ""; public int Status { get; set; } }
public sealed class BreakdownApi { public int Id { get; set; } public string Title { get; set; } = ""; public string Description { get; set; } = ""; public int Severity { get; set; } public int Status { get; set; } public EquipmentApi? Equipment { get; set; } public DateTime ReportedUtc { get; set; } }
public sealed class DiagnosisApi { public int Id { get; set; } }
public sealed class InterventionApi { public int Id { get; set; } public string Title { get; set; } = ""; public string? Resolution { get; set; } public int Status { get; set; } public EquipmentApi? Equipment { get; set; } public DateTime CreatedUtc { get; set; } }
public sealed class UserApi { public string Id { get; set; } = ""; public string Email { get; set; } = ""; public string DisplayName { get; set; } = ""; public string[] Roles { get; set; } = []; }
public sealed class DashboardData { public int EquipmentCount { get; set; } public int BrokenEquipment { get; set; } public int OpenBreakdowns { get; set; } public int OpenInterventions { get; set; } public List<BreakdownApi> RecentBreakdowns { get; set; } = []; public List<InterventionApi> RecentInterventions { get; set; } = []; }
public sealed class ReportData { public int TotalBreakdowns { get; set; } public int ResolvedBreakdowns { get; set; } public int TotalInterventions { get; set; } public int CompletedInterventions { get; set; } public decimal LaborHours { get; set; } public decimal TotalCost { get; set; } }